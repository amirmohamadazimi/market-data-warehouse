# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# Data — keep raw and generated data out of git
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
*.parquet
# The replay sample is in git on purpose (D15). Must come AFTER *.parquet:
# gitignore uses the last rule that matches.
!data/sample/**
*.db
*.sqlite

# Outputs
outputs/*
!outputs/.gitkeep
*.png
!docs/figures/*.png

# OS / editor
.DS_Store
.vscode/
.idea/
